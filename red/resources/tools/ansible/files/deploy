#!/usr/local/bin/bb

;; The ForceCommand behind every deploy key. It is what makes an ephemeral,
;; unattended deploy key safe to hand to CI: a leaked key can trigger `once
;; update` for the hosts named in its own authorized_keys entry and nothing
;; else. Loosening this widens the blast radius of every key on the box at
;; once, so change it deliberately — deploy_test.clj guards the rules.
;;
;; Keys are per repository, so the entry carries every host that repository
;; serves. The client sends nothing at all: everything this needs it already
;; has from the entry, which is what lets one key cover several hosts without
;; the caller enumerating them.

(require '[babashka.process :as p]
         '[clojure.string :as str])

(defn die [msg]
  (binding [*out* *err*]
    (println (str "deploy: " msg)))
  (System/exit 1))

(defn warn [msg]
  (binding [*out* *err*]
    (println (str "deploy: " msg))))

(def host-pattern #"^[A-Za-z0-9]([A-Za-z0-9.-]{0,253}[A-Za-z0-9])?$")

(defn update-host [host]
  (let [{:keys [exit]} @(p/process ["sudo" "/usr/local/bin/once-deploy-app" host]
                                  {:out :inherit :err :inherit})]
    (when-not (zero? exit) (warn (str "once update failed for " host)))
    (zero? exit)))

(defn -main [& args]
  ;; The permitted hosts arrive from the authorized_keys entry, not from the
  ;; client, so one repository's key cannot update another's application.
  (let [permitted (->> args (map str) (map str/trim) (remove str/blank?) distinct vec)]
    (when (empty? permitted)
      (die "no permitted hosts configured for this key"))
    (doseq [host permitted]
      (when-not (re-matches host-pattern host)
        (die (str "invalid permitted host: " host))))
    ;; Ignored rather than rejected. Rejecting would break every workflow still
    ;; sending the old `sudo once update <host>` the moment this script lands,
    ;; before those repositories have been updated. Nothing is given up by
    ;; accepting it: `restrict` plus this forced command mean the client's
    ;; string could never select anything in the first place.
    (when-not (str/blank? (str (System/getenv "SSH_ORIGINAL_COMMAND")))
      (warn "ignoring the requested command; this key updates its own hosts"))
    ;; mapv, not remove: these calls have side effects and must all run, in
    ;; order, before anything looks at the results.
    (let [results (mapv (fn [host] [host (update-host host)]) permitted)
          failed (mapv first (remove second results))]
      (when (seq failed)
        (die (str "failed: " (str/join " " failed))))
      (println (str "deploy: updated " (str/join " " permitted)))
      (System/exit 0))))

(when (= *file* (System/getProperty "babashka.file"))
  (apply -main *command-line-args*))
