#!/usr/bin/env bb
;; Green launcher for a production, single-server ONCE stack.
;;
;; Desired state lives in colors.yml, found by walking up from the working
;; directory. Secrets and tokens are never written there: every credential key
;; is supplied at runtime through a COLORS_PAR_* environment variable, which is
;; overlaid onto the matching flat key.
;;
;; This file is both the skill payload and the repository entry point —
;; ./green in the project root is a symlink to it. It deliberately holds no
;; logic of its own: validation, the workflow graph, and the steps all live in
;; the `once` library, where they are covered by tests. What remains is the
;; part that cannot live there — resolving the library in the first place.

(require '[babashka.fs :as fs]
         '[clojure.java.io :as io]
         '[clojure.string :as str])

(def script-dir
  (let [file (if (= "NO_SOURCE_PATH" *file*)
               (fs/path (fs/cwd) "green")
               (fs/path *file*))]
    (str (fs/parent (fs/canonicalize file)))))

;; ---------------------------------------------------------------------------
;; Dependency bootstrap
;;
;; Neither `once` nor `green` is published to Clojars yet, so a standalone copy
;; of this launcher resolves both as immutable git dependencies. When the
;; classpath already provides `once` (running inside the project, where bb.edn
;; supplies local roots) the bootstrap is skipped entirely. ONCE_LIB_ROOT and
;; GREEN_LIB_ROOT override a pin with a working tree.

(def ^:private launcher-contract
  "Minimum io.github.getcolors/once contract this launcher requires.
  Guarded at run time so a stale pin fails loudly instead of rendering
  templates from an older commit."
  11)

;; Managed by `bb pin` — do not edit by hand.
(def ^:private once-sha "adeb1f7738a11293bdde6343b16fddbfe92bb2ae")
(def ^:private green-sha "1c1fb81563287c98aa1bcd0e12cd755296e6d98e")

(def ^:private once-git-url "https://github.com/getcolors/once.git")
(def ^:private green-git-url "https://github.com/getcolors/green.git")

(defn- lib-coord
  [env-var url sha deps-root]
  (if-let [root (System/getenv env-var)]
    {:local/root root}
    (cond-> {:git/url url :git/sha sha}
      deps-root (assoc :deps/root deps-root))))

(when (and (System/getProperty "babashka.version")
           (nil? (io/resource "io/github/getcolors/once/tools.clj")))
  ((requiring-resolve 'babashka.deps/add-deps)
   {:deps {'io.github.getcolors/once (lib-coord "ONCE_LIB_ROOT" once-git-url once-sha "green")
           'io.github.getcolors/green (lib-coord "GREEN_LIB_ROOT" green-git-url green-sha nil)}}))

(require '[babashka.cli :as bb-cli]
         '[green.cli :as green-cli])

;; A pin old enough to predate a namespace this launcher needs would fail with
;; a bare "could not locate" error, which says nothing about what to do. Load
;; them defensively so the contract check below can answer instead.
(def ^:private load-error
  (try
    (require 'io.github.getcolors.once.describe
             'io.github.getcolors.once.workflow)
    nil
    (catch Throwable t (or (ex-message t) (str (class t))))))

(defn- once-contract
  []
  (or (some-> (requiring-resolve 'io.github.getcolors.once.utils/contract) deref)
      0))

(defn- contract-error
  "Return an outcome map when the resolved `once` predates this launcher."
  []
  (let [resolved (if load-error 0 (once-contract))]
    (when (< resolved launcher-contract)
      {:green/exit 2
       :green/err (str "this launcher requires once contract " launcher-contract
                       " but resolved " resolved "\n"
                       "the pinned commit " (subs once-sha 0 7)
                       " predates this launcher; update the skill or repin"
                       (when load-error (str "\n" load-error)))})))

;; ---------------------------------------------------------------------------
;; Desired-state file resolution

(defn- find-up
  "The nearest `name` at or above `dir`, or nil at the filesystem root."
  [name dir]
  (loop [dir (.getAbsoluteFile (io/file dir))]
    (when dir
      (let [candidate (io/file dir name)]
        (if (.exists candidate)
          (str candidate)
          (recur (.getParentFile dir)))))))

(defn- default-file
  "The nearest colors.yml at or above the working directory, falling back to
  one beside this launcher. Walking up means a colour can be run from any
  subdirectory of a project and still find the one desired state; the skill
  copies this file next to a project's colors.yml, and the repository keeps it
  under skills/, a directory deeper."
  []
  (or (find-up "colors.yml" ".")
      (let [beside-script (io/file script-dir "colors.yml")]
        (when (.exists beside-script) (str beside-script)))
      "colors.yml"))

(defn- file-arg?
  [arg]
  (or (= "-f" arg)
      (= "--file" arg)
      (str/starts-with? (str arg) "--file=")))

(defn default-args
  [args]
  (let [args (vec args)]
    (cond-> args
      (not-any? file-arg? args) (conj "-f" (default-file)))))

(defn- describe-args
  [args]
  (:file (:opts (bb-cli/parse-args (vec (rest args))
                                   {:spec {:file {:alias :f
                                                  :default (default-file)}}}))))

;; ---------------------------------------------------------------------------
;; CLI

(def usage
  "Usage: green <build|create|delete|describe> [-f|--file colors.yml] [--dry-run]")

(defn run
  "REPL-friendly entry point that returns the final opts map."
  [& args]
  (let [args (default-args args)
        command (first args)]
    (cond
      (contains? #{"help" "--help" "-h"} command) {:green/exit 0 :green/err usage}
      (contains? #{"create" "delete" "build" "describe"} command)
      ;; resolved rather than aliased: the namespaces are only known to have
      ;; loaded once contract-error has passed
      (or (contract-error)
          (if (= "describe" command)
            ((requiring-resolve 'io.github.getcolors.once.describe/describe-file)
             (describe-args args))
            (green-cli/run-cli
             @(requiring-resolve 'io.github.getcolors.once.workflow/workflow)
             args)))
      :else {:green/exit 2 :green/err usage})))

(defn -main
  [& args]
  (let [{:green/keys [exit err trace]} (apply run args)]
    (when err
      (binding [*out* (if (zero? (or exit 0)) *out* *err*)]
        (println err)
        (when trace (println trace))))
    (System/exit (or exit 0))))

(defn- launched-as-script?
  []
  (when-let [bb-file (System/getProperty "babashka.file")]
    (= (str (fs/canonicalize bb-file))
       (str (fs/canonicalize *file*)))))

(when (launched-as-script?)
  (apply -main *command-line-args*))
